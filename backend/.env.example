# AI Project Intelligence & Risk Advisor — backend environment
# Copy to `.env` and adjust values. NEVER commit your real .env.

APP_ENV=development

# ---- Database -------------------------------------------------------------
# SQLite is the default (file path relative to notifications dir).
# Swap to Postgres later, e.g.: postgresql+psycopg://user:pass@localhost/dbname
DATABASE_URL=sqlite:///./data/app.db

# ---- Auth -----------------------------------------------------------------
# IMPORTANT: set a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ---- File storage & uploads ------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# ---- AI Provider: Ollama (primary) -----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
AI_PROVIDER=ollama
AI_TEMPERATURE=0.1
AI_MAX_CHUNKS=6
AI_REQUEST_TIMEOUT=180

# ---- Fallback chain --------------------------------------------------------
# Deterministic order: Ollama -> Groq -> Gemini -> OpenRouter -> Hugging Face.
# A provider is skipped when it is unconfigured, unreachable, timing out, or
# returning an error. Requests are sequential; providers are never called in
# parallel. Set AI_FALLBACK_ENABLED=false to pin the app to Ollama only.
AI_FALLBACK_ENABLED=true
# AI_REQUEST_TIMEOUT is the TOTAL budget for one request (all attempts).
# This caps a single provider attempt so one dead provider cannot consume the
# whole budget before the next one is tried.
AI_PROVIDER_ATTEMPT_TIMEOUT=20
# How long a failed provider is fast-failed before it is retried (seconds).
AI_PROVIDER_BREAKER_COOLDOWN=60

# ---- Fallback 1: Groq ------------------------------------------------------
# OpenAI-compatible base URL (do NOT include /chat/completions).
# Docs: https://console.groq.com/docs/openai-compatibility
# GROQ_API_KEY is the ONLY value you must supply.
# GROQ_MODEL is optional: leave blank for automatic model discovery, which reads
# the live catalogue from GET <GROQ_BASE_URL>/models, picks a chat/text model
# and caches it for the running backend process. Fill it in only to pin a model.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# ---- Fallback 2: Gemini -----------------------------------------------------
# OpenAI-compatible base URL (do NOT include /chat/completions).
# Docs: https://ai.google.dev/gemini-api/docs/openai
# GEMINI_API_KEY is the ONLY value you must supply.
# GEMINI_MODEL is optional: leave blank for automatic model discovery, which
# lists the models your key can reach and picks one that supports
# generateContent. No model name is hardcoded anywhere in the app.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=

# ---- Embeddings (kept separate from the LLM) --------------------------------
# Embeddings ALWAYS stay on local Ollama. Never point these at a cloud provider.
EMBEDDING_PROVIDER=ollama           # ollama | external | sentence_transformers (optional)
EMBEDDING_MODEL=nomic-embed-text    # used by the ollama embedding provider

# ---- Vector database -------------------------------------------------------
VECTOR_DB_PATH=./data/vector_db

# ---- Chunking --------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Generic external providers (fallback 3, 4 and an extra slot) ----------
# All three are optional. Leave blank to skip. The app runs with Ollama only.
# Each endpoint must be an OpenAI-compatible BASE URL (no /chat/completions).
# For every slot the API KEY is the only required value.

# Fallback 3 - OpenRouter. Docs: https://openrouter.ai/docs/quickstart
# EXTERNAL_PROVIDER_1_MODEL: leave blank for automatic model discovery via
# GET https://openrouter.ai/api/v1/models
EXTERNAL_PROVIDER_1_NAME=OpenRouter
EXTERNAL_PROVIDER_1_BASE_URL=https://openrouter.ai/api/v1
EXTERNAL_PROVIDER_1_API_KEY=
EXTERNAL_PROVIDER_1_MODEL=

# Fallback 4 - Hugging Face Inference Providers.
# Docs: https://huggingface.co/docs/inference-providers
# EXTERNAL_PROVIDER_2_MODEL: leave blank for automatic model discovery, which
# keeps only models with a live provider that can emit text
EXTERNAL_PROVIDER_2_NAME=Hugging Face
EXTERNAL_PROVIDER_2_BASE_URL=https://router.huggingface.co/v1
EXTERNAL_PROVIDER_2_API_KEY=
EXTERNAL_PROVIDER_2_MODEL=

# Extra (any other OpenAI-compatible endpoint, tried after the five above).
# Same rule: leave EXTERNAL_PROVIDER_3_MODEL blank for automatic model discovery.
EXTERNAL_PROVIDER_3_NAME=OpenAI-Compatible
EXTERNAL_PROVIDER_3_BASE_URL=
EXTERNAL_PROVIDER_3_API_KEY=
EXTERNAL_PROVIDER_3_MODEL=

# ---- First administrator (secure bootstrap, optional) ----------------------
# If set AND the database has zero users, this account is created on first start.
# Otherwise use the in-app "Create administrator" setup screen.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator